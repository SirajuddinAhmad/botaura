# GIWA Sepolia RPC & Network Configuration
GIWA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_CHAIN_ID=91342
EXPLORER_URL=https://sepolia-explorer.giwa.io

# Transaction Settings
MIN_TX_AMOUNT_ETH=0.000001
MAX_TX_AMOUNT_ETH=0.00001
TX_PER_WALLET_PER_ROUND=5

# Delay / Sleep (Anti-Sybil) dalam detik
MIN_DELAY_BETWEEN_TX=15
MAX_DELAY_BETWEEN_TX=45
MIN_DELAY_BETWEEN_WALLET=30
MAX_DELAY_BETWEEN_WALLET=90

# Auto Loop Settings
AUTO_LOOP=false
LOOP_INTERVAL_HOURS=24

# AuraLaunch API Endpoint (jika ada update API resmi)
AURA_API_BASE_URL=https://beta.auralaunch.org/api
